{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigil.example/schemas/finding.v1.json",
  "title": "Finding",
  "description": "Target per-certificate contract for Vigil findings (matches vigil.models.Finding). Not emitted by `vigil watch` yet; see docs/architecture.md, \"Output contract\", for the current JSONL.",
  "type": "object",
  "required": [
    "schema_version",
    "detected_at",
    "cert",
    "verdicts",
    "score"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp at which detection ran."
    },
    "cert": {
      "$ref": "#/$defs/CertEvent"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verdicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DomainVerdict"
      }
    },
    "skipped_domains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "$defs": {
    "CertEvent": {
      "type": "object",
      "description": "A single certificate observed on a Certificate Transparency log.",
      "required": [
        "serial_number",
        "signature_algo",
        "issuer_common_name",
        "validity_not_before",
        "validity_not_after",
        "domains",
        "source",
        "is_precert"
      ],
      "additionalProperties": false,
      "properties": {
        "serial_number": {
          "type": "string"
        },
        "signature_algo": {
          "type": "string"
        },
        "issuer_country": {
          "type": [
            "string",
            "null"
          ]
        },
        "issuer_organisation": {
          "type": [
            "string",
            "null"
          ]
        },
        "issuer_common_name": {
          "type": "string"
        },
        "validity_not_before": {
          "type": "string",
          "format": "date-time"
        },
        "validity_not_after": {
          "type": "string",
          "format": "date-time"
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Raw SANs as reported by the CT log, wildcards included, unnormalised."
        },
        "source": {
          "type": "string"
        },
        "cert_index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "is_precert": {
          "type": "boolean"
        }
      }
    },
    "Reason": {
      "type": "object",
      "required": [
        "family",
        "rule",
        "points"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "points": {
          "type": "integer"
        }
      }
    },
    "DomainVerdict": {
      "type": "object",
      "required": [
        "domain",
        "score",
        "reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string"
        },
        "matched_watch_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reason"
          }
        }
      }
    }
  }
}
